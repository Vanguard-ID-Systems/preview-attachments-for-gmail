{
  "manifest_version": 3,
  "name": "Compose on the Left for Gmail",
  "version": "0.2.0",
  "description": "Adds a button to Gmail's compose window that moves it to the bottom-left, so the email you are reading stays visible. Click again to move it back.",
  "homepage_url": "https://github.com/Vanguard-ID-Systems/compose-on-the-left-for-gmail",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/selectors.js", "src/toggle.js", "src/dock.js", "src/main.js"],
      "run_at": "document_idle"
    }
  ]
}
